# RabbitMQ TLS connection
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5671
RABBITMQ_USER=celery
RABBITMQ_PASS=celerypass
RABBITMQ_VHOST=/

# Path to the CA cert that signed the RabbitMQ server cert
RABBITMQ_CA_CERT=docker/certs/ca.crt

# Where the notification task writes its proof-of-execution files
RESULT_DIR=result
